---
import Layout from "../layouts/Layout.astro";

const heroes = [
    {
        id: 1,
        title: "30 years of building for the web.",
        summary:
            "From the early days of PHP to modern web platforms, I've spent decades turning ideas into software. And I'm still enjoying the journey.",
        image: "experience.png",
    },
    {
        id: 2,
        title: "I enjoy solving difficult problems.",
        summary:
            "Whether it's designing APIs, building scalable systems, or simplifying complex requirements, I care about creating software that's reliable, maintainable, and built to last.",
        image: "engineering.png",
    },
    {
        id: 3,
        title: "Good software is built by good teams.",
        summary:
            "I enjoy leading developers, sharing knowledge, shaping technical direction, and helping teams turn challenging ideas into products that work.",
        image: "leadership.png",
    },
];
---

<Layout title="Kusmayadi" description="Kusmayadi's personal website">
    <div id="carousel" class="carousel w-full client:load">
        {
            heroes.map((hero) => {
                return (
                    <div
                        id=`item${hero.id}`
                        class="carousel-item w-full text-6xl font-bold"
                    >
                        <div class="hero min-h-screen" style=`background-image: url(/images/${hero.image});`>
                            <div class="hero-overlay" />
                            <div class="hero-content">
                                <div class="w-full">
                                    <h1 class="mb-9 text-6xl font-bold">{hero.title}</h1>
                                    <p class="mb-5 text-3xl">{hero.summary}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                );
            })
        }
    </div>
</Layout>
<script>
    // ---- Config ----
    const carouselId = "carousel";
    const interval = 5000; // time between slides
    const pauseOnHover = false;

    // ---- Setup ----
    const carousel = document.getElementById(carouselId);
    let slides: Element[] | null[] = [];
    if (carousel) {
        slides = Array.from(carousel.querySelectorAll(".carousel-item"));
    }

    const playPauseBtn = document.getElementById("playPauseBtn");

    let currentIndex = 0;
    let timer: NodeJS.Timeout | number | string | undefined;
    let isPlaying = true;

    function goToSlide(index: number) {
        if (carousel && slides.length === 0) return;
        currentIndex = (index + slides.length) % slides.length;
        slides[currentIndex]?.scrollIntoView({
            behavior: "smooth",
            block: "nearest",
            inline: "start",
        });
    }

    function nextSlide() {
        goToSlide(currentIndex + 1);
    }

    function startAutoplay() {
        stopAutoplay(); // avoid duplicate timers
        timer = setInterval(nextSlide, interval);
        isPlaying = true;
        if (playPauseBtn) playPauseBtn.textContent = "Pause";
    }

    function stopAutoplay() {
        clearInterval(timer);
        isPlaying = false;
        if (playPauseBtn) playPauseBtn.textContent = "Play";
    }

    playPauseBtn?.addEventListener("click", () => {
        isPlaying ? stopAutoplay() : startAutoplay();
    });

    if (pauseOnHover) {
        carousel?.addEventListener("mouseenter", stopAutoplay);
        carousel?.addEventListener("mouseleave", () => {
            if (!timer) startAutoplay();
        });
    }

    // init
    startAutoplay();
</script>
