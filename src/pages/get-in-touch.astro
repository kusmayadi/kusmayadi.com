---
import Layout from "../layouts/Layout.astro";
import { Image, Picture } from "astro:assets";
import linkedInLogo from "../assets/linkedin.png";
import githubLogo from "../assets/github-mark.png";
import xLogo from "../assets/x-logo-black.png";
---

<Layout title="Get in Touch" description="Get in touch with Kusmayadi">
    <section
        class="flex w-full flex-col rounded-lg bg-[#eceff4] px-5 py-7 text-[#3b4252] sm:px-9"
    >
        <h1 class="mb-7">Get in Touch</h1>
        <p class="mb-7">You can contact me through my social media channel:</p>

        <div class="flex items-center gap-4 py-4 sm:gap-6">
            <a href="https://www.linkedin.com/in/kusmayadi/" target="linkedin"
                ><Image src={linkedInLogo} alt="LinkedIn" class="w-14 sm:w-20" /></a
            >

            <a href="https://github.com/kusmayadi" target="github"
                ><Picture src={githubLogo} alt="github" class="w-14 sm:w-20" />
            </a>
            <a href="https://twitter.com/kusmayadi" target="twitter"
                ><Picture src={xLogo} alt="X" class="w-12 sm:w-16" /></a
            >
        </div>
    </section>
</Layout>
