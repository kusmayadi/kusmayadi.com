---
import type { GetStaticPaths } from "astro";
import { getCollection, type CollectionEntry, render } from "astro:content";
import DynamicImage from "@/components/DynamicImage.astro";
import Layout from "@/layouts/Layout.astro";
import { Picture } from "astro:assets";

interface Props {
    project: CollectionEntry<"projects">;
}

export const getStaticPaths = (async () => {
    const projects = await getCollection("projects");
    return projects.map((project: CollectionEntry<"projects">) => ({
        params: { slug: project.data.slug },
        props: { project },
    }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={project.data.name}>
    <section class="min-h-screen w-full px-3 pt-23 sm:px-4 lg:px-0">
        <div class="container flex flex-col gap-6 lg:flex-row lg:space-x-5">
            {
                project.data.image && (
                    <div class="w-full rounded lg:w-1/3 lg:max-h-[calc(100vh-theme(spacing.24))]">
                        <figure>
                            <DynamicImage
                                imagePath={`/src/assets/projects/${project.data.image}`}
                                altText={project.data.name}
                                class="max-h-96 rounded object-cover object-top shadow-xl lg:max-h-[calc(100vh-theme(spacing.24))]"
                                loading="eager"
                            />
                        </figure>
                    </div>
                )
            }

            <div class="relative w-full pb-6 lg:w-2/3">
                <h1 class="mb-6 sm:mb-10">{project.data.name}</h1>
                <div class="text-base leading-relaxed sm:text-xl">
                    <Content />
                </div>
                <div class="mt-8">
                    <div>
                        <div class="text-sm badge badge-lg">
                            {project.data.year}
                        </div>
                        {
                            project.data.techStacks.length >= 1 && (
                                <div class="mt-4 flex flex-wrap gap-1">
                                    {project.data.techStacks.map((tech) => (
                                        <span class="badge badge-sm badge-accent">
                                            {tech}
                                        </span>
                                    ))}
                                </div>
                            )
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>
