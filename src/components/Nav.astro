---
import { lazy } from "astro:schema";
import avatar from "../assets/kusmayadi.png";
import { Picture } from "astro:assets";
---

<div class="drawer drawer-end">
    <input id="nav-drawer" type="checkbox" class="drawer-toggle" />

    <div class="drawer-content">
        <header
            id="header"
            class="fixed top-0 z-40 w-full pt-4 transition-all duration-300"
        >
            <div class="container mx-auto flex items-center justify-between gap-2 px-3">
                <div
                    class="flex items-center space-x-2 rounded-box bg-primary px-3 py-2 text-primary-content"
                >
                    <div class="avatar">
                        <div class="w-10 rounded-md">
                            <Picture src={avatar} alt="Kusmayadi" loading={lazy} />
                        </div>
                    </div>

                    <div class="hidden text-xl sm:block">Kusmayadi</div>
                </div>

                <label
                    for="nav-drawer"
                    aria-label="Open navigation menu"
                    class="btn btn-square border-0 bg-primary text-primary-content lg:hidden"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        class="h-6 w-6"
                        aria-hidden="true"
                    >
                        <path d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </label>

                <div class="hidden lg:block">
                    <ul class="menu menu-horizontal rounded-box bg-primary text-primary-content">
                        <li><a href="/" class="nav-link" title="Home">Home</a></li>
                        <li><a href="/about-me" class="nav-link" title="About Me">About Me</a></li>
                        <li><a href="/experience" class="nav-link" title="Work Experience">Experience</a></li>
                        <li><a href="/projects" class="nav-link" title="Projects">Projects</a></li>
                        <li><a href="/skills" class="nav-link" title="Skills">Skills</a></li>
                    </ul>
                </div>
            </div>
        </header>
    </div>

    <div class="drawer-side z-50">
        <label for="nav-drawer" aria-label="Close navigation menu" class="drawer-overlay"></label>
        <ul class="menu min-h-full w-72 bg-primary p-4 pt-24 text-primary-content">
            <li><a href="/" class="nav-link">Home</a></li>
            <li><a href="/about-me" class="nav-link">About Me</a></li>
            <li><a href="/experience" class="nav-link">Experience</a></li>
            <li><a href="/projects" class="nav-link">Projects</a></li>
            <li><a href="/skills" class="nav-link">Skills</a></li>
        </ul>
    </div>
</div>

<script>
    const initHeader = () => {
        const header = document.getElementById("header");
        const classOnScroll = [
            "bg-primary",
            "shadow-xl",
            "md:rounded-b-xl",
            "py-0",
        ];
        const classOnTop = ["bg-transparent", "pt-4", "pb-0"];

        const checkScroll = () => {
            if (window.scrollY > 50) {
                classOnScroll.forEach((className) => {
                    header?.classList.add(className);
                });

                classOnTop.forEach((className) => {
                    header?.classList.remove(className);
                });
            } else {
                classOnScroll.forEach((className) => {
                    header?.classList.remove(className);
                });

                classOnTop.forEach((className) => {
                    header?.classList.add(className);
                });
            }
        };

        checkScroll();

        window.addEventListener("scroll", checkScroll);
    };

    document.addEventListener("DOMContentLoaded", initHeader);
</script>
