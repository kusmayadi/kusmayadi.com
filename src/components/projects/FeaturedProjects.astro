---
import { type CollectionEntry } from "astro:content";
import DynamicImage from "@/components/DynamicImage.astro";

interface Props {
    projects: CollectionEntry<"projects">[];
}
const { projects } = Astro.props;
---

<section class="container mx-auto mb-6 w-full px-3 sm:px-4 lg:px-0">
    <div class="carousel w-full">
        {
            projects.map(async (project, index) => {
                const nextProject =
                    index == projects.length - 1
                        ? null
                        : projects[index + 1].data.id;
                const prevProject =
                    index == 0 ? null : projects[index - 1].data.id;

                return (
                    <div
                        id={project.id}
                        class="carousel-item relative w-full shrink-0 snap-center pt-24 pb-10 lg:max-h-[calc(100svh-(--spacing(24)))]"
                    >
                        <div class="flex flex-col overflow-hidden rounded-md bg-base-300 shadow-xl lg:h-[calc(100svh-(--spacing(24)))] lg:flex-row">
                            <div class="w-full shrink-0 lg:h-full lg:w-1/2">
                                {project.data.image && (
                                    <a href={`/projects/${project.data.slug}`}>
                                        <figure>
                                            <DynamicImage
                                                imagePath={`/src/assets/projects/${project.data.image}`}
                                                altText={project.data.name}
                                                class="h-64 w-full rounded-t-md object-cover object-top shadow-xl sm:h-80 lg:h-full lg:rounded-l-md lg:rounded-t-none"
                                                loading="eager"
                                            />
                                        </figure>
                                    </a>
                                )}
                            </div>
                            <div class="flex min-w-0 w-full flex-col p-5 sm:p-8 lg:w-1/2 lg:p-10">
                                <h2 class="mb-3 text-4xl! sm:text-6xl! lg:mb-5 lg:text-8xl!">
                                    {project.data.name}
                                </h2>
                                <div class="my-2 text-sm leading-relaxed sm:text-base lg:my-5">
                                    {project.data.summary
                                        .split("\n\n")
                                        .map((paragraph) => (
                                            <p class="mb-5">{paragraph}</p>
                                        ))}
                                </div>
                                <div class="mt-auto pt-2">
                                    {project.data.techStacks.length >= 1 && (
                                        <div class="mt-4 flex flex-wrap gap-1">
                                            {project.data.techStacks.map(
                                                (tech) => (
                                                    <span class="badge badge-sm badge-accent whitespace-nowrap">
                                                        {tech}
                                                    </span>
                                                ),
                                            )}
                                        </div>
                                    )}
                                    <a
                                        href={`/projects/${project.data.slug}`}
                                        class="btn btn-md mt-3 w-full text-lg sm:w-auto"
                                    >
                                        Read More
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="pointer-events-none absolute inset-x-2 top-1/2 z-10 flex -translate-y-1/2 transform justify-between sm:inset-x-5">
                            {prevProject && (
                                <a
                                    href={`#${prevProject}`}
                                    aria-label="Previous project"
                                    class="btn btn-circle pointer-events-auto btn-sm sm:btn-md"
                                >
                                    ❮
                                </a>
                            )}
                            {prevProject == null && <div />}
                            {nextProject && (
                                <a
                                    href={`#${nextProject}`}
                                    aria-label="Next project"
                                    class="btn btn-circle pointer-events-auto btn-sm sm:btn-md"
                                >
                                    ❯
                                </a>
                            )}
                            {nextProject == null && <div />}
                        </div>
                    </div>
                );
            })
        }
    </div>
</section>
