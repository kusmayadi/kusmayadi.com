---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
    imagePath: string;
    altText: string;
    width?: number;
    class?: string;
    loading?: "eager" | "lazy";
}

const { imagePath, altText, loading = "eager" } = Astro.props;

// 1. Match files globally using Vite. Adjust the folder path format to fit your needs.
const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/**/*.{jpeg,jpg,png,gif,webp}",
);

// 2. Validate if the targeted file path exists within the resolved map
if (!images[imagePath]) {
    throw new Error(
        `"${imagePath}" does not exist in glob: "/src/assets/**/*.{jpeg,jpg,png,gif,webp}"`,
    );
}
---

<!-- 3. Resolve the entry promise dynamically inside the src attribute -->
<Picture
    src={images[imagePath]()}
    alt={altText}
    width={Astro.props.width}
    class:list={[Astro.props.class]}
    loading={Astro.props.loading}
    layout="full-width"
/>
