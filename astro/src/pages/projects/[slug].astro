---
import type { GetStaticPaths } from "astro";
import { getCollection, type CollectionEntry, render } from "astro:content";
import DynamicImage from "@/components/DynamicImage.astro";
import Layout from "@/layouts/Layout.astro";
import { Picture } from "astro:assets";

interface Props {
    project: CollectionEntry<"projects">;
}

export const getStaticPaths = (async () => {
    const projects = await getCollection("projects");
    return projects.map((project: CollectionEntry<"projects">) => ({
        params: { slug: project.data.slug },
        props: { project },
    }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={project.data.name}>
    <section class="min-h-screen pt-23">
        <div class="container flex space-x-5">
            {
                project.data.image && (
                    <div class="w-1/3 max-h-[calc(100vh-theme(spacing.24))] rounded">
                        <figure>
                            <DynamicImage
                                imagePath={`/src/assets/projects/${project.data.image}`}
                                altText={project.data.name}
                                class="object-top object-cover max-h-[calc(100vh-theme(spacing.24))] rounded shadow-xl"
                                loading="eager"
                            />
                        </figure>
                    </div>
                )
            }

            <div class="w-2/3 relative">
                <h1 class="mb-10">{project.data.name}</h1>
                <div class="text-xl">
                    <Content />
                </div>
                <div class="absolute bottom-0">
                    <div>
                        <div class="text-sm badge badge-lg">
                            {project.data.year}
                        </div>
                        {
                            project.data.techStacks.length >= 1 && (
                                <div class="flex space-x-1 mt-4">
                                    {project.data.techStacks.map((tech) => (
                                        <span class="badge badge-sm badge-accent">
                                            {tech}
                                        </span>
                                    ))}
                                </div>
                            )
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>
