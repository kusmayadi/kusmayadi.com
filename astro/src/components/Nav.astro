---
import { lazy } from "astro:schema";
import avatar from "../assets/kusmayadi.png";
import { Picture } from "astro:assets";
---

<header class="fixed top-0 w-full pt-4 z-40">
    <div class="container mx-auto flex items-center justify-between px-3">
        <div
            class="flex space-x-2 items-center bg-primary text-primary-content rounded-box px-3 py-2"
        >
            <div class="avatar">
                <div class="w-10 rounded-md">
                    <Picture src={avatar} alt="Kusmayadi" loading={lazy} />
                </div>
            </div>

            <div class="text-xl">Kusmayadi</div>
        </div>
        <div>
            <ul
                class="menu menu-vertical lg:menu-horizontal bg-primary text-primary-content rounded-box"
            >
                <li><a href="/" class="nav-link" title="Home">Home</a></li>
                <li>
                    <a href="/about-me" class="nav-link" title="About Me">
                        About Me
                    </a>
                </li>
                <li>
                    <a
                        href="/experience"
                        class="nav-link"
                        title="Work Experience"
                    >
                        Experience
                    </a>
                </li>
                <li>
                    <a href="/projects" class="nav-link" title="Projects">
                        Projects
                    </a>
                </li>
                <li>
                    <a href="/skills" class="nav-link" title="Skills">
                        Skills
                    </a>
                </li>
                <li>
                    <a href="/get-in-touch" class="nav-link" title="Contact Me">
                        Get in Touch
                    </a>
                </li>
            </ul>
        </div>
    </div>
</header>
